# =============================================================================
# TransactionFlow — Git line-ending policy
# =============================================================================
# Shell scripts MUST stay LF so they execute correctly inside Linux containers
# (e.g. spark-jobs/entrypoint.sh would fail with CRLF on Windows checkouts).

# Default: let Git normalise to LF in the repo, check out natively
* text=auto

# Shell scripts — always LF, even on Windows
*.sh text eol=lf

# Java source — normalise, native checkout
*.java text eol=lf

# Web / config source
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.json text eol=lf

# Config / markup
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.properties text eol=lf
*.xml  text eol=lf
*.sql  text eol=lf
Dockerfile text eol=lf

# Truly binary — never diff/merge
*.jar  binary
*.class binary
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
